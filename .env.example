# Copy to .env for a local test run. Never commit real values.
LLM_PROVIDER=gemini            # gemini (free tier) or claude (paid)
LLM_MODEL=                     # optional; defaults: gemini-2.5-flash / claude-opus-5-5
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
LOCAL_STORE_PATH=local_posts.json   # used when SHEET_ID is empty
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
LINKEDIN_TOKEN_EXPIRES_ON=
